FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir celery redis sqlalchemy pydantic pydantic-settings email-validator psycopg2-binary "psycopg[binary]" reportlab requests python-dotenv alembic openai pymupdf python-docx playwright beautifulsoup4

COPY . .

CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=info"]
