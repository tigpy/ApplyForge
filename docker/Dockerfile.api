FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
RUN pip install --no-cache-dir uvicorn fastapi pydantic pydantic-settings email-validator sqlalchemy psycopg2-binary "psycopg[binary]" redis reportlab requests python-dotenv alembic celery openai pymupdf python-docx beautifulsoup4

COPY . .

EXPOSE 8000

CMD ["python", "scripts/run_server.py"]
