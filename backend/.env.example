# Copy to backend/.env (never commit .env). Every value is optional for local mock development.

# AI: Support for Google Gemini (Google AI Studio) and OpenAI (or leave empty for deterministic mock AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_PROVIDER=auto            # auto | gemini | openai | mock

# Email notifications: leave empty to use the mock notifier (recorded in application events).
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=
NOTIFICATION_MODE=auto      # auto | email | mock

# Storage (relative paths resolve from the repository root)
DATABASE_URL=sqlite:///./data/applyforge.db
RESUME_DIR=./resumes

# Automation
APPLICATION_CONNECTOR=mock  # mock | playwright
BROWSER_HEADLESS=true
MATCH_THRESHOLD=75
MAX_APPLICATIONS_PER_RUN=10
MAX_UPLOAD_MB=5
CORS_ORIGINS=http://localhost:5173
ALLOW_LOCAL_URLS=false
