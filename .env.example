# ApplyForge Environment Configuration Example
APP_NAME=ApplyForge
APP_ENV=development
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/applyforge

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# OpenAI API (for Structured Outputs & Grounding)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai

# Inviolable Safety Guardrails
SAFE_MODE=true
ZERO_SILENT_SUBMISSIONS=true

# Security
SECRET_KEY=change-this-insecure-secret-key-in-production

# Next.js Web Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
